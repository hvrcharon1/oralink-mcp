# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── OAuth 2.0 ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_JWT_SECRET=CHANGE_ME_256_bit_random_hex
OAUTH_TOKEN_EXPIRY=3600
OAUTH_REFRESH_TOKEN_EXPIRY=2592000

# Set by Anthropic/Claude.ai when registering as a marketplace connector
OAUTH_CLIENT_ID=oralink-mcp-client
OAUTH_CLIENT_SECRET=CHANGE_ME_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# ── Encryption (credentials at rest) ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
