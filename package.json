  "keywords": ["mcp", "oracle", "autonomous-database", "oracledb", "ai-connector", "claude", "llm"],
  "author": "Datacules LLC",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "express": "^4.21.2",
    "oracledb": "^6.8.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "vitest": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
