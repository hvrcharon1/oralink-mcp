{
  "name": "oralink-mcp",
  "version": "0.4.0",
  "description": "Oracle Autonomous Database MCP Server — OAuth-compatible hosted connector for Claude.ai and any MCP client",
  "private": false,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
